	keywords = {Model, Tidal Channels, Elevation thresholds, Vegetation Dynamics},
	pages = {104346},
	annote = {Similar to the Belliard article, except this looks more specifically at the hydrodynamics-would love to compare the two findings and see if there are differences
Can be used to cite to show that vegetation affects sediment deposition 


},
	file = {PDF:C\:\\Users\\savan\\Zotero\\storage\\ICKHX7F3\\Taylor-Burns et al. - 2023 - The influence of vegetated marshes on wave transformation in sheltered estuaries.pdf:application/pdf;PDF:C\:\\Users\\savan\\Zotero\\storage\\8BN2HCNB\\Taylor-Burns et al. - 2023 - The influence of vegetated marshes on wave transformation in sheltered estuaries.pdf:application/pdf;PDF:C\:\\Users\\savan\\Zotero\\storage\\RGCW67IH\\Taylor-Burns et al. - 2023 - The influence of vegetated marshes on wave transformation in sheltered estuaries.pdf:application/pdf;Taylor-Burns et al. - 2023 - The influence of vegetated marshes on wave transfo.pdf:C\:\\Users\\savan\\Zotero\\storage\\3IFYSKZF\\Taylor-Burns et al. - 2023 - The influence of vegetated marshes on wave transfo.pdf:application/pdf},
