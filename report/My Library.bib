@article{mfikili_sediment_2022,
	title = {Sediment deposition and its implications for vertical accretion in an intertidal salt marsh—{A} case study of a microtidal estuary along the southeast coast of {South} {Africa}},
	volume = {51},
	issn = {23524855},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S2352485522000226},
	doi = {10.1016/j.rsma.2022.102203},
	abstract = {Salt marshes are one of the most productive ecosystems in the world, however their continued existence is in doubt in the face of global sea-level rise, especially where development creates coastal squeeze preventing landward migration. Therefore, long-term survival of these ecosystems is in part dependent on sufficient and persistent sediment supply from riverine and marine sources to maintain positive surface elevation equal to or higher than that of relative sea-level rise. The aim of this study was to investigate the sediment deposition and the implication thereof for vertical accretion in a small salt marsh of a microtidal estuary along the south-east coast of South Africa. The estuarine bed sediments were primarily composed of medium-sized sand with only a limited fine-grained fraction (overall mean of 1.3 ± 0.4\%, n = 92) confined mostly to the confluence section of the Bitou tributary. Grain size frequency distribution revealed slightly coarse and poorly sorted sediments in the Bitou tributary suggesting deposition during low-energy conditions. The intertidal surface was characterized by silty-sized sediments dominated by clay mineral assemblages. These sediments had a mean organic matter content and bulk density of 7.2 ± 5.48\% and 2.02 ± 0.94 g cm3 respectively. Bulk density was dependent on particle size and organic matter content with bulk density predicted to increase with increasing sand content (R = 0.32, p = 0.00044), whereas decreasing trends were observed with an increase in silt, clay and organic matter (R = -0.31, p = 0.0005; R = -0.13, p = 0.14 and R = -0.61, p = 1.2 × 10−13), respectively. The mean short-term sediment deposition was 0.143 ± 0.01 g cm2 tide1 (n = 120). Streamside sites consistently had high deposition rates suggesting that the shallow estuarine channel and tidal creeks adjacent to the monitored intertidal areas were the likely sediment source. The mean vertical accretion rate was estimated at 0.08 ± 0.07 cm yr1 (i.e., 0.8 mm yr1). Although these accretion rates are lower than the local sea-level rise rates of 2.19 mm yr1, increasing vertical accretion rates are predicted with increasing sediment deposition and a decrease in bulk density. Continued monitoring of the sediment starved Keurbooms Estuary is recommended through the installation of Rod Surface Elevation Tables (RSETs) to assess the impact of extreme events such as riverine flooding on sediment supply to the intertidal salt marsh.},
	language = {en},
	urldate = {2026-08-23},
	journal = {Regional Studies in Marine Science},
	author = {Mfikili, Athi N. and Bornman, Thomas G. and Du Preez, Derek R.},
	month = mar,
	year = {2022},
	pages = {102203},
	file = {PDF:C\:\\Users\\savan\\Zotero\\storage\\FNG263F8\\Mfikili et al. - 2022 - Sediment deposition and its implications for vertical accretion in an intertidal salt marsh—A case s.pdf:application/pdf},
}

