@article{brueske_effects_1994,
	title = {Effects of vegetation and hydrologic load on sedimentation patterns in experimental wetland ecosystems},
	volume = {3},
	issn = {0925-8574},
	url = {https://www.sciencedirect.com/science/article/pii/0925857494000115},
	doi = {10.1016/0925-8574(94)00011-5},
	abstract = {Vegetation and water velocity effects on patterns of sediment deposition were tested by monitoring sedimentation rates in dense cattail, open water, and transitional vegetation zones at distances of 5, 10, and 20 m from the inflows of two experimental wetland basins at the Des Plaines River Wetlands Demonstration Project, northeastern Illinois, USA. One basin received a high hydrologic load (up to 50 cm/wk) and one basin received a low load (up to 6 cm/wk). Sediment deposition rates within 20 m of the inflows reached 3300 g dry wt m−2 day−1 in the high-load basin and 700 g dry wt m−2 day−1 in the low-load basin. Vegetation patterns did not have a significant effect (P {\textgreater} 0.05) on sediment deposition rates in the high-load basin, whereas water velocity effects on rates of sedimentation were significant (P {\textless} 0.01) in three of four periods of monitoring. In the low-load basin, vegetation effects were significant (P {\textless} 0.01) during the entire period of investigation. Experimental research at this scale aids in the assessment of design criteria for constructed wetlands.},
	number = {4},
	urldate = {2025-06-23},
	journal = {Ecological Engineering},
	author = {Brueske, Christopher C. and Barrett, Gary W.},
	month = dec,
	year = {1994},
	keywords = {Sedimentation, Constructed wetlands, Freshwater wetlands, Illinois USA},
	pages = {429--447},
	file = {ScienceDirect Snapshot:C\:\\Users\\savan\\Zotero\\storage\\WQ24KKVJ\\0925857494000115.html:text/html},
}

