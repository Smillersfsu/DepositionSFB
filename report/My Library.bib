@article{crabot_highly_2023,
	title = {Do highly anthropized hydrological conditions in marshes influence fish communities according to their life‐history strategies?},
	volume = {39},
	issn = {1535-1459, 1535-1467},
	url = {https://onlinelibrary.wiley.com/doi/10.1002/rra.4150},
	doi = {10.1002/rra.4150},
	abstract = {Alterations of natural hydrology in aquatic ecosystems are known to strongly impact the community composition of different taxa. Surprisingly, literature on the potential influence of hydrology on fish community composition is still very scarce in agricultural marshes, where canals represent one of the few remaining aquatic habitats. This study is aimed to address this research gap by monitoring fish communities in independent hydrological units differing in hydrology management over a 6 years period. We predicted variable fish responses to the hydrological context according to different life-history strategies (opportunistic, equilibrium, or periodic species). Periodic and opportunistic species were the most frequently observed. Despite differences in hydrology between canals (but little variation over years), we found that hydrology explained only a very low proportion of variation in the composition of fish communities. In particular, the flooding duration of meadows in early spring did not influence the composition of fish communities, not even the abundance of periodic species expected to rely on such temporary habitats. Instead, fish communities were more influenced by local habitat variables (aquatic vegetation cover, turbidity, tree roots, and refuges under the canal banks). The hydrological management of most hydrological units for agricultural purposes (i.e., severe flood abatement in spring and shallow water depth in canals in summer) was found to be incompatible with conservation goals to promote more diverse fish communities between hydrological units. Therefore, we call for further investigations in similar habitats covering a larger range of hydrological conditions.},
	language = {en},
	number = {8},
	urldate = {2024-10-10},
	journal = {River Research and Applications},
	author = {Crabot, Julie and Bergerot, Benjamin and Bonis, Anne and Gore, Olivier and Mauchamp, André and Paillisson, Jean‐Marc},
	month = oct,
	year = {2023},
	keywords = {Europe, Trophic Interactions, Constituents of Concern},
	pages = {1551--1577},
	file = {Crabot et al. - 2023 - Do highly anthropized hydrological conditions in m.pdf:C\:\\Users\\savan\\Zotero\\storage\\KZPYP6IN\\Crabot et al. - 2023 - Do highly anthropized hydrological conditions in m.pdf:application/pdf},
}

@article{champlin_use_2023,
	title = {Use of historical isoscapes to develop an estuarine nutrient baseline},
	volume = {10},
	issn = {2296-7745},
	url = {https://www.frontiersin.org/articles/10.3389/fmars.2023.1257015/full},
	doi = {10.3389/fmars.2023.1257015},
	abstract = {Coastal eutrophication is a prevalent threat to the healthy functioning of ecosystems globally. While degraded water quality can be detected by monitoring oxygen, nutrient concentrations, and algal abundance, establishing regulatory guidelines is complicated by a lack of baseline data (e.g., pre-Anthropocene). We use historical carbon and nitrogen isoscapes over {\textasciitilde}300 years from sediment cores to reconstruct spatial and temporal changes in nutrient dynamics for a central California estuary, Elkhorn Slough, where development and agriculture dramatically enhanced nutrient inputs over the past century. We found strong contrasts between current sediment stable isotopes and those from the recent past, demonstrating shifts exceeding those in previously studied eutrophic estuaries and substantial increases in nutrient inputs. Comparisons of contemporary with historical isoscapes also revealed that nitrogen sources shifted from a historical marine-terrestrial gradient with higher δ
              15
              N near the inlet to amplified denitrification at the head and mouth of the modern estuary driven by increased N inputs. Geospatial analysis of historical data suggests that an increase in fertilizer application – rather than population growth or increases in the extent of cultivated land – is chiefly responsible for increasing nutrient loads during the 20
              th
              century. This study demonstrates the ability of isotopic and stoichiometric maps to provide important perspectives on long-term shifts and spatial patterns of nutrients that can be used to improve management of nutrient pollution.},
	language = {en},
	urldate = {2024-09-27},
	journal = {Frontiers in Marine Science},
	author = {Champlin, Lena K. and Woolfolk, Andrea and Oczkowski, Autumn J. and Rittenhouse, Audrey and Gray, Andrew B. and Wasson, Kerstin and Rahman, Farzana I. and Zelanko, Paula and Quintana Krupinski, Nadine B. and Jeppesen, Rikke and Haskins, John and Watson, Elizabeth B.},
	month = sep,
	year = {2023},
	keywords = {Geology, Elkhorn Slough},
	pages = {1257015},
	file = {Champlin et al. - 2023 - Use of historical isoscapes to develop an estuarin.pdf:C\:\\Users\\savan\\Zotero\\storage\\GT8FUUS4\\Champlin et al. - 2023 - Use of historical isoscapes to develop an estuarin.pdf:application/pdf},
