	keywords = {San Francisco Bay Area, Important, Pickleweed, Sediment Transport, Vegetation Dynamics},
	pages = {1163--1181},
	file = {Callaway et al. - 2012 - Carbon Sequestration and Sediment Accretion in San.pdf:C\:\\Users\\savan\\Zotero\\storage\\YMV5KZ58\\Callaway et al. - 2012 - Carbon Sequestration and Sediment Accretion in San.pdf:application/pdf},
